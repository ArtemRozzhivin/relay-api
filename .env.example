# Copy to .env for local development.

# --- shared: API and worker ---
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public
REDIS_URL=redis://localhost:6379
JOB_MAX_ATTEMPTS=5
# Object storage (D29). The bucket's region, and the bucket itself — the dev one
# here, a separate prod bucket on the deployed server.
AWS_REGION=eu-central-1
S3_BUCKET=your-dev-bucket
# The relay-dev IAM user's access key, allowed into that one bucket only. Read
# by the AWS SDK itself; never commit real values. Leave both out where the
# host provides a role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for an S3-compatible emulator; leave unset for AWS.
# S3_ENDPOINT=http://localhost:9000
# Serves GET /metrics on this port when set, apart from the API's own port. Set
# it per process, not here: the API and the worker both read this file.
#   METRICS_PORT=9464 npm run start:dev
#   METRICS_PORT=9465 npm run start:worker:dev

# --- API only ---
PORT=3000
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-and-make-it-different-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# The origins a browser may call the API and the socket from, comma-separated.
# Empty admits none; scripts and curl send no Origin and are not affected.
CORS_ORIGINS=http://localhost:3000
# Behind a reverse proxy, the proxy whose X-Forwarded-For names the client: its
# addresses (loopback, a subnet) or a hop count. Unset, the client's address is
# the connection's — right with no proxy in front, and never set it to true.
# TRUST_PROXY=loopback
# Rate limits: a baseline on every route, stricter where a request costs work.
# Off only for the test tiers. Never off in production.
RATE_LIMITS=true
# Argon2id cost. These are OWASP's minimum (2 passes, 19 MiB); raise them in
# production as far as login latency allows, never lower.
ARGONID_TIME_COST=2
ARGONID_MEMORY_COST=19456
# Crashes submit() after the transaction commits but before the enqueue, to
# prove the outbox relay recovers the job (assertion A6). Never set in production.
RELAY_FAULT_AFTER_COMMIT=false

# --- worker only ---
WORKER_CONCURRENCY=5
# ai.enrich runs on a queue of its own (D6a). Its jobs at once in this worker,
# and how many may start, across every worker, in each window: a job makes at
# most two requests, so 20 a minute stays under a provider's 50 requests a
# minute.
AI_WORKER_CONCURRENCY=2
AI_QUEUE_LIMIT_MAX=20
AI_QUEUE_LIMIT_DURATION_MS=60000
# How often the worker looks for unfinished jobs the queue no longer delivers —
# the backstop for an abandonment the 'failed' event lost (§7.6).
RELAY_SWEEP_INTERVAL_MS=60000
# Drops the 'failed' event's abandonment, as a worker killed at that moment
# would, to prove the sweep recovers the job (assertion A5d). Never set in
# production.
RELAY_FAULT_SKIP_ABANDON=false
# Fails an import's first attempt right after it fans out its pipeline's
# batches, so its retry writes them again, to prove the unique key refuses
# every one (assertion A23). Never set in production.
RELAY_FAULT_AFTER_FAN_OUT=false
