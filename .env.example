# Copy to .env for local development.

# --- shared: API and worker ---
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public
REDIS_URL=redis://localhost:6379
JOB_MAX_ATTEMPTS=5
# Object storage (D29). The bucket's region, and the bucket itself — the dev one
# here, a separate prod bucket on the deployed server.
AWS_REGION=eu-central-1
S3_BUCKET=your-dev-bucket
# The relay-dev IAM user's access key, allowed into that one bucket only. Read
# by the AWS SDK itself; never commit real values. Leave both out where the
# host provides a role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for an S3-compatible emulator; leave unset for AWS.
# S3_ENDPOINT=http://localhost:9000

# --- API only ---
PORT=3000
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-and-make-it-different-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:3000
# Argon2id cost. These are OWASP's minimum (2 passes, 19 MiB); raise them in
# production as far as login latency allows, never lower.
ARGONID_TIME_COST=2
ARGONID_MEMORY_COST=19456
# Crashes submit() after the transaction commits but before the enqueue, to
# prove the outbox relay recovers the job (assertion A6). Never set in production.
RELAY_FAULT_AFTER_COMMIT=false

# --- worker only ---
WORKER_CONCURRENCY=5
# How often the worker looks for unfinished jobs the queue no longer delivers —
# the backstop for an abandonment the 'failed' event lost (§7.6).
RELAY_SWEEP_INTERVAL_MS=60000
# Drops the 'failed' event's abandonment, as a worker killed at that moment
# would, to prove the sweep recovers the job (assertion A5d). Never set in
# production.
RELAY_FAULT_SKIP_ABANDON=false
