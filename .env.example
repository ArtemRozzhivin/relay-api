# Copy to .env for local development.

# --- shared: API and worker ---
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public
REDIS_URL=redis://localhost:6379
JOB_MAX_ATTEMPTS=5

# --- API only ---
PORT=3000
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-and-make-it-different-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:3000

# --- worker only ---
WORKER_CONCURRENCY=5
