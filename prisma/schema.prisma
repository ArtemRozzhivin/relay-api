generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  jobs          Job[]
  products      Product[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  DEAD_LETTERED
  CANCELLED
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  type            String
  payload         Json
  status          JobStatus @default(QUEUED)
  attempts        Int       @default(0)
  /// The ownership token: every claim increments it and nothing resets it, unlike
  /// `attempts`, which a re-drive resets — so no two deliveries ever share one (D7).
  lease           Int       @default(0)
  maxAttempts     Int       @default(5)
  idempotencyKey  String
  /// SHA-256 of the canonical submit body: a reused key with a different body is
  /// a 422, not a replay (D28). NULL on rows from before it was stored.
  requestHash     String?
  result          Json?
  error           Json?
  progress        Json?
  /// What the last committed batch recorded, so a retry or a re-drive resumes
  /// after it (D26). Written in the batch's own transaction; never sent to a client.
  checkpoint      Json?
  cancelRequested Boolean   @default(false)
  correlationId   String
  /// Milliseconds, not microseconds: the list's cursor carries it through a JS Date (D14).
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  startedAt       DateTime? @db.Timestamptz(6)
  finishedAt      DateTime? @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sideEffects SideEffect[]
  outbox      Outbox[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model SideEffect {
  id        String   @id @default(uuid()) @db.Uuid
  effectKey String   @unique
  jobId     String   @db.Uuid
  kind      String
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  jobId       String    @db.Uuid
  queue       String
  jobName     String
  payload     Json
  /// Publishes by the relay only: the direct path marks a row published without
  /// touching it, so 0 on a published row means the fast path delivered it.
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// A store's product, written by `import.csv`. A store knows it by its own `sku`, never by
/// our `id`, so `(userId, sku)` is what an import matches on — and what makes a replayed batch
/// harmless (D30).
model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  sku            String
  name           String
  description    String?
  /// Whole minor units, never a float: 0.1 + 0.2 is not 0.3.
  priceCents     Int
  /// ISO 4217, three capital letters.
  currency       String
  /// As written in the file, so untrusted until phase C's guard has checked it.
  imageUrl       String?
  /// `READY` or `FAILED`: what image.process concluded about `imageSourceUrl`. Describes the
  /// product's image only while `imageSourceUrl` equals `imageUrl`.
  imageStatus    String?
  imageSourceUrl String?
  /// Why the image at `imageSourceUrl` could not be used; set only when `FAILED`.
  imageError     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
}
